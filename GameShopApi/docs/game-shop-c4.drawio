<diagram id="c4_1" name="1. Context"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="640"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1_title" value="C4 · Уровень 1 · Context: Game Currency Shop" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="2" width="900" height="32" as="geometry"/></mxCell><mxCell id="d1_note" value="Пунктир: внешние системы, в MVP эмулируются." style="text;html=1;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="24" y="604" width="1100" height="24" as="geometry"/></mxCell><mxCell id="d1_buyer" value="&lt;b&gt;Покупатель&lt;/b&gt;&lt;br&gt;[Person] Покупает игровую валюту и пополнение Steam" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="260" height="110" as="geometry"/></mxCell><mxCell id="d1_admin" value="&lt;b&gt;Администратор магазина&lt;/b&gt;&lt;br&gt;[Person] Управляет каталогом товаров" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="260" height="110" as="geometry"/></mxCell><mxCell id="d1_sys" value="&lt;b&gt;Game Currency Shop&lt;/b&gt;&lt;br&gt;[Software System] Веб-магазин: регистрация, каталог игр, корзина, оплата, история покупок" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="450" y="250" width="300" height="150" as="geometry"/></mxCell><mxCell id="d1_pay" value="&lt;b&gt;Платёжный провайдер&lt;/b&gt;&lt;br&gt;[External System] В MVP заменён таймером 5 с" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8a8a8a;fontColor=#ffffff;strokeColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="260" height="110" as="geometry"/></mxCell><mxCell id="d1_steam" value="&lt;b&gt;Игровые платформы (Steam)&lt;/b&gt;&lt;br&gt;[External System] Зачисление валюты (в MVP не интегрировано)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8a8a8a;fontColor=#ffffff;strokeColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="870" y="440" width="260" height="110" as="geometry"/></mxCell><mxCell id="d1_e0" value="Регистрируется, выбирает товары, оплачивает заказ" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1_buyer" target="d1_sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d1_e1" value="Добавляет и изменяет товары" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1_admin" target="d1_sys"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d1_e2" value="Запрашивает оплату" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="d1_sys" target="d1_pay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d1_e3" value="Передаёт заказ на зачисление" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="d1_sys" target="d1_steam"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="c4_2" name="2. Container"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1760" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d2_title" value="C4 · Уровень 2 · Container: Game Currency Shop" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="2" width="900" height="32" as="geometry"/></mxCell><mxCell id="d2_note" value="Серая пунктирная рамка: граница системы. Серый блок с пунктиром: внешняя система, в MVP эмулируется." style="text;html=1;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="24" y="764" width="1100" height="24" as="geometry"/></mxCell><mxCell id="d2_boundary" value="Game Currency Shop  [Software System]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="44" width="1130" height="726" as="geometry"/></mxCell><mxCell id="d2_buyer" value="&lt;b&gt;Покупатель&lt;/b&gt;&lt;br&gt;[Person] Пользуется магазином в браузере" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="210" height="110" as="geometry"/></mxCell><mxCell id="d2_admin" value="&lt;b&gt;Администратор&lt;/b&gt;&lt;br&gt;[Person] Смотрит и правит данные в БД" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="30" y="590" width="210" height="110" as="geometry"/></mxCell><mxCell id="d2_web" value="&lt;b&gt;Web App (SPA)&lt;/b&gt;&lt;br&gt;[HTML, CSS, JavaScript] Вход, каталог, корзина, окно оплаты, профиль" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="340" y="100" width="240" height="120" as="geometry"/></mxCell><mxCell id="d2_gw" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;[Nginx] Единая точка входа: маршрутизация, rate limit, логи" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="240" height="120" as="geometry"/></mxCell><mxCell id="d2_api" value="&lt;b&gt;API Service&lt;/b&gt;&lt;br&gt;[ASP.NET Core 8] Авторизация, каталог, заказы, оплата (муляж)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="260" height="130" as="geometry"/></mxCell><mxCell id="d2_pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;[Database] Таблицы users, products, purchases" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="1180" y="210" width="230" height="120" as="geometry"/></mxCell><mxCell id="d2_redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;[Cache] Кэш каталога товаров" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="1180" y="490" width="230" height="120" as="geometry"/></mxCell><mxCell id="d2_pga" value="&lt;b&gt;pgAdmin 4&lt;/b&gt;&lt;br&gt;[Web UI] Просмотр и управление базой данных" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="750" y="590" width="260" height="110" as="geometry"/></mxCell><mxCell id="d2_pay" value="&lt;b&gt;Платёжный провайдер&lt;/b&gt;&lt;br&gt;[External System] В MVP: таймер 5 с" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8a8a8a;fontColor=#ffffff;strokeColor=#555555;dashed=1;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="220" height="110" as="geometry"/></mxCell><mxCell id="d2_e0" value="Открывает в браузере" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2_buyer" target="d2_web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2_e1" value="HTTP, JSON (REST)" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2_web" target="d2_gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2_e2" value="Проксирует /api/*, /products и статику" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2_gw" target="d2_api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2_e3" value="SQL, Npgsql (TCP 5432)" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2_api" target="d2_pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2_e4" value="Кэш каталога (TCP 6379)" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2_api" target="d2_redis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2_e5" value="Оплата заказа" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="d2_api" target="d2_pay"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2_e6" value="Открывает в браузере" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2_admin" target="d2_pga"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d2_e7" value="SQL (TCP 5432)" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d2_pga" target="d2_pg"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="c4_3" name="3. Component"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="830"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d3_title" value="C4 · Уровень 3 · Component: API Service" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="2" width="900" height="32" as="geometry"/></mxCell><mxCell id="d3_note" value="Компоненты показаны логически: в коде MVP они лежат в Program.cs и Mvp.cs." style="text;html=1;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="24" y="794" width="1100" height="24" as="geometry"/></mxCell><mxCell id="d3_boundary" value="API Service  [ASP.NET Core 8]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="335" y="44" width="965" height="746" as="geometry"/></mxCell><mxCell id="d3_gw" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;[Nginx] Пересылает запросы клиента" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="200" height="110" as="geometry"/></mxCell><mxCell id="d3_ae" value="&lt;b&gt;Auth Endpoints&lt;/b&gt;&lt;br&gt;[Minimal API] /api/register, login, me, password, rename" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="360" y="90" width="230" height="110" as="geometry"/></mxCell><mxCell id="d3_pe" value="&lt;b&gt;Payment Endpoints&lt;/b&gt;&lt;br&gt;[Minimal API] /api/pay, /api/purchases; токен проверяет Auth Service" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="360" y="330" width="230" height="110" as="geometry"/></mxCell><mxCell id="d3_ce" value="&lt;b&gt;Catalog Endpoints&lt;/b&gt;&lt;br&gt;[Minimal API] /products: GET, POST, PUT, DELETE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="360" y="570" width="230" height="110" as="geometry"/></mxCell><mxCell id="d3_as" value="&lt;b&gt;Auth Service&lt;/b&gt;&lt;br&gt;[C#] PBKDF2-хеш пароля, выдача и проверка токена" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="230" height="110" as="geometry"/></mxCell><mxCell id="d3_ps" value="&lt;b&gt;Payment Service&lt;/b&gt;&lt;br&gt;[C#] Проверка корзины, расчёт суммы, запись покупки" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="230" height="110" as="geometry"/></mxCell><mxCell id="d3_cs" value="&lt;b&gt;Catalog Service&lt;/b&gt;&lt;br&gt;[C#] Каталог по схеме cache-aside через Redis" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="700" y="570" width="230" height="110" as="geometry"/></mxCell><mxCell id="d3_ur" value="&lt;b&gt;Users Repository&lt;/b&gt;&lt;br&gt;[Npgsql] таблица users" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="1050" y="90" width="220" height="90" as="geometry"/></mxCell><mxCell id="d3_pr" value="&lt;b&gt;Purchases Repository&lt;/b&gt;&lt;br&gt;[Npgsql] таблица purchases" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="1050" y="340" width="220" height="90" as="geometry"/></mxCell><mxCell id="d3_gr" value="&lt;b&gt;Products Repository&lt;/b&gt;&lt;br&gt;[Npgsql] таблица products" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="1050" y="520" width="220" height="90" as="geometry"/></mxCell><mxCell id="d3_cc" value="&lt;b&gt;Cache Client&lt;/b&gt;&lt;br&gt;[Redis client] ключ products:all" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#0b1f33;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="1050" y="650" width="220" height="90" as="geometry"/></mxCell><mxCell id="d3_pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;[Database]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="1380" y="230" width="190" height="110" as="geometry"/></mxCell><mxCell id="d3_redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;[Cache]" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#2b5c8a;" vertex="1" parent="1"><mxGeometry x="1380" y="650" width="190" height="110" as="geometry"/></mxCell><mxCell id="d3_e0" value="HTTP/JSON" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_gw" target="d3_ae"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e1" value="HTTP/JSON" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_gw" target="d3_pe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e2" value="HTTP/JSON" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_gw" target="d3_ce"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e3" value="вызывает" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_ae" target="d3_as"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e4" value="вызывает" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_pe" target="d3_ps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e5" value="вызывает" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_ce" target="d3_cs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e6" value="читает/пишет" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_as" target="d3_ur"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e7" value="сохраняет" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_ps" target="d3_pr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e8" value="при промахе" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_cs" target="d3_gr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e9" value="get/set" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_cs" target="d3_cc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e10" value="SQL" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_ur" target="d3_pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e11" value="SQL" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_pr" target="d3_pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e12" value="SQL" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_gr" target="d3_pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d3_e13" value="TCP 6379" style="endArrow=classic;html=1;strokeColor=#444444;strokeWidth=2;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d3_cc" target="d3_redis"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
